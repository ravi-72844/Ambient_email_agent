# ---------- Copy this file to .env and fill in your keys. NEVER commit .env ----------

# Google Gemini key: https://aistudio.google.com/ -> "Get API key"
# Leave empty to run in MOCK mode (keyword-based fake LLM, only for testing the pipeline)
GOOGLE_API_KEY=
# Use the same model name that works in scripts/hello_gemini.py
GEMINI_MODEL=gemini-3.8-flash

# LangSmith tracing + evaluation: https://smith.langchain.com -> Settings -> API Keys
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=ambient-email-agent

# mock = simulated inbox/calendar (safe).  google = real Gmail + Calendar (see docs/GMAIL_SETUP.md)
EMAIL_BACKEND=mock
TIMEZONE=Asia/Kolkata
POLL_SECONDS=60
